<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PutzApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Putz"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth2 callback deep link: putz://oauth#access_token=TOKEN -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="oauth" />
            </intent-filter>
            <!-- Handle magnet: links shared from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <!-- Replace cover deep link: putz://replace_cover?uuid=UUID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="replace_cover" />
            </intent-filter>

            <!-- Update comments deep link: putz://update_comments?uuid=UUID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="update_comments" />
            </intent-filter>

            <!-- Add/edit tags deep link: putz://add_tags?uuid=UUID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="add_tags" />
            </intent-filter>
        </activity>

        <!-- CONTRACT: FUSE_BOOKS — receives fusion intents from CalibreAnywhere -->
        <activity
            android:name=".ui.fusion.FuseBooksActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Putz">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="fuse_books" />
            </intent-filter>
        </activity>

        <!-- CONTRACT: MANAGE_VIRTUAL_LIBRARY — receives VL management intents from CalibreAnywhere -->
        <activity
            android:name=".ui.virtuallibraries.ManageVirtualLibraryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Putz">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="manage_virtual_library" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.damarquez.putz.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
