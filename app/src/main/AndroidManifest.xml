<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CONTRACT: self-update — lets Putz prompt to install a downloaded update APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PutzApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Putz"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth2 callback deep link: putz://oauth#access_token=TOKEN -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="oauth" />
            </intent-filter>
            <!-- Handle magnet: links shared from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <!-- Replace cover deep link: putz://replace_cover?uuid=UUID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="replace_cover" />
            </intent-filter>

            <!-- Update comments deep link: putz://update_comments?uuid=UUID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="update_comments" />
            </intent-filter>

            <!-- Add/edit tags deep link: putz://add_tags?uuid=UUID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="add_tags" />
            </intent-filter>

            <!-- Batch add tags deep link: putz://batch_add_tags?uuids=UUID1,UUID2,... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="batch_add_tags" />
            </intent-filter>

            <!-- CONTRACT: GENERATE_COVER — putz://generate_cover?uuid=UUID&title=TITLE&author=AUTHOR -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="generate_cover" />
            </intent-filter>

            <!-- CONTRACT: EXTRACT_OR_RANDOM_COVER — putz://extract_or_random_cover?uuid=UUID&title=TITLE&author=AUTHOR -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="extract_or_random_cover" />
            </intent-filter>

            <!-- CONTRACT: SET_PAGE_COUNT — putz://set_page_count?uuid=UUID&pages=N -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="set_page_count" />
            </intent-filter>

            <!-- CONTRACT: edit_metadata deep link — putz://edit_metadata?uuid=UUID&title=...&author=...&comments=...&tags=...&pages=N -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="edit_metadata" />
            </intent-filter>

            <!-- CONTRACT: CONFIRM_DELETE_BOOK — putz://confirm_delete_book?uuid=UUID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="confirm_delete_book" />
            </intent-filter>

            <!-- CONTRACT: CONFIRM_DELETE_FORMATS — putz://confirm_delete_formats?uuid=UUID&formats=EPUB,PDF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="confirm_delete_formats" />
            </intent-filter>

            <!-- CONTRACT: PROTECT_BOOK — putz://protect_book?uuid=UUID&title=TITLE&author=AUTHOR -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="protect_book" />
            </intent-filter>

            <!-- CONTRACT: UNPROTECT_BOOK — putz://unprotect_book?uuid=UUID&title=TITLE&author=AUTHOR -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="unprotect_book" />
            </intent-filter>

            <!-- CONTRACT: CONVERT_FORMAT — putz://convert_format?uuid=UUID&source_format=EPUB&target_format=PDF&title=TITLE&author=AUTHOR -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="convert_format" />
            </intent-filter>

            <!-- CONTRACT: REINDEX_BOOK — putz://reindex_content?uuid=UUID&title=TITLE&author=AUTHOR -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="reindex_content" />
            </intent-filter>
        </activity>

        <!-- CONTRACT: FUSE_BOOKS / JOIN_BOOKS — receives fuse and join intents from CalibreAnywhere -->
        <activity
            android:name=".ui.fusion.FuseBooksActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Putz">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="fuse_books" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="join_books" />
            </intent-filter>
        </activity>

        <!-- CONTRACT: MOVE_FORMAT — putz://move_format?source_uuid=UUID&dest_uuid=UUID&format=EPUB&title=TITLE&author=AUTHOR -->
        <activity
            android:name=".ui.moveformat.MoveFormatActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Putz">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="move_format" />
            </intent-filter>
        </activity>

        <!-- CONTRACT: SPLIT_BOOK — putz://split_book, payload rides in the "split_payload" Intent extra -->
        <activity
            android:name=".ui.splitbook.SplitBookActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Putz">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="split_book" />
            </intent-filter>
        </activity>

        <!-- CONTRACT: MANAGE_VIRTUAL_LIBRARY — receives VL management intents from CalibreAnywhere -->
        <activity
            android:name=".ui.virtuallibraries.ManageVirtualLibraryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Putz">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="manage_virtual_library" />
            </intent-filter>
        </activity>

        <!-- CONTRACT: RENAME_AUTHOR — receives rename/merge-author intents from CalibreAnywhere -->
        <activity
            android:name=".ui.authors.RenameAuthorActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Putz">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="putz" android:host="rename_author" />
            </intent-filter>
        </activity>

        <service
            android:name=".sync.TransferDeleteService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".sync.TransferPrepareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.damarquez.putz.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
